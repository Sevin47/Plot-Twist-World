# Optional — enables shared-world multiplayer. Without these, the game
# runs single-player using localStorage.
VITE_SUPABASE_URL=https://trjrbqkwxmsfxlqermam.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_9gCebFKxRzIrFSxOv69OhQ_lEZNzisu

# Optional — enables real geography for district classification (actual
# OSM water/land-use/building data instead of an approximate procedural
# guess). Without this, the game falls back to a coarser built-in model.
VITE_PROTOMAPS_KEY=2b7d008a0e14d21c

# Optional — enables the "energy alerts" push notification toggle. Public
# half of a VAPID keypair (see supabase/functions/send-energy-alerts).
VITE_VAPID_PUBLIC_KEY=

# REQUIRED if the Supabase project has captcha protection turned on
# (Authentication -> Attack Protection). hCaptcha's public site key — the
# secret half lives in the Supabase dashboard, never here. Without this,
# "Play now" (anonymous sign-in) is rejected by Supabase; sign-in with
# Google is unaffected. See src/captcha.js.
VITE_HCAPTCHA_SITE_KEY=

# REQUIRED — CARTO now watermarks anonymous basemap requests ("API KEY
# REQUIRED" burned into the tile PNG itself, server-side), so without this
# every tile on the map carries the watermark. Free tier is 5M tile
# requests/month, issued instantly at carto.com/basemaps/apikey. Public,
# domain-scoped key — meant to ship to the client.
VITE_CARTO_KEY=
